.fm-tip {
  padding: 24rpx 32rpx 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.fm-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  margin: 0 32rpx 16rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.fm-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.fm-info { flex: 1; min-width: 0; }
.fm-name { font-size: 30rpx; font-weight: 700; }
.fm-owner {
  font-size: 20rpx;
  color: #d97706;
  background: #fef3c7;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 8rpx;
  font-weight: 400;
}
.fm-role { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }

.fm-del {
  padding: 10rpx 22rpx;
  background: #fef2f2;
  color: #dc2626;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-sheet {
  width: 750rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}
.modal-handle { width: 72rpx; height: 8rpx; background: #ddd; border-radius: 4rpx; margin: 0 auto 24rpx; }
.modal-title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.form-group { margin-bottom: 28rpx; }
.form-label { font-size: 26rpx; font-weight: 600; color: #4b5563; margin-bottom: 12rpx; }
.form-input {
  width: 100%;
  border: 2rpx solid #e5e5e5;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  background: #fff;
  box-sizing: border-box;
}
.emoji-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14rpx; }
.emoji-opt {
  border-radius: 20rpx;
  background: #fafafa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  padding: 18rpx 0;
  border: 4rpx solid transparent;
}
.emoji-opt.selected { background: #fef3c7; border-color: #f59e0b; }
.modal-btns { display: flex; gap: 18rpx; margin-top: 32rpx; }
