page {
  height: 100%;
}

.chat-wrap {
  padding: 28rpx 32rpx 160rpx;
}

.msg-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.msg-bubble {
  max-width: 76%;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  font-size: 27rpx;
  line-height: 1.6;
  white-space: pre-line;
  word-break: break-all;
}

.msg-row.ai .msg-bubble {
  background: #fff;
  color: #1a1a1a;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  border-top-left-radius: 6rpx;
}

.msg-row.user .msg-bubble {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  border-top-right-radius: 6rpx;
}

/* 快捷问题 */
.quick-row {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 120rpx;
  z-index: 5;
}

.quick-scroll {
  white-space: nowrap;
  padding: 0 32rpx;
}

.quick-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #fff;
  border: 2rpx solid #fde68a;
  color: #92400e;
  border-radius: 28rpx;
  font-size: 24rpx;
  margin-right: 14rpx;
}

/* 输入栏 */
.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-top: 1rpx solid #e5e5e5;
}

.photo-btn {
  font-size: 44rpx;
}

.chat-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 16rpx 26rpx;
  font-size: 28rpx;
}

.send-btn {
  padding: 14rpx 28rpx;
  background: #e5e5e5;
  color: #999;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.send-btn.active {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
}
