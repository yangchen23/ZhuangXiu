.ac-tip {
  padding: 24rpx 32rpx 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.ac-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 32rpx 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.ac-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}

.ac-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #fffbeb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.ac-info { flex: 1; min-width: 0; }
.ac-name { font-size: 28rpx; font-weight: 600; }
.ac-progress { font-size: 22rpx; color: #f59e0b; font-weight: 600; margin-top: 2rpx; }

.ac-bar {
  width: 120rpx;
  height: 12rpx;
  background: #f3f4f6;
  border-radius: 6rpx;
  overflow: hidden;
}

.ac-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #d97706);
  border-radius: 6rpx;
}

.ac-arr { font-size: 20rpx; color: #9ca3af; }

.ac-body {
  padding: 0 28rpx 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.ac-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.ac-item:last-of-type { border-bottom: none; }

.ac-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: transparent;
  flex-shrink: 0;
}

.ac-check.done {
  background: #22c55e;
  border-color: #22c55e;
  color: #fff;
}

.ac-text { font-size: 26rpx; color: #1a1a1a; }
.ac-text.done { color: #9ca3af; text-decoration: line-through; }
