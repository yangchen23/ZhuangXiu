.sp-tip {
  padding: 24rpx 32rpx 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.sp-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 32rpx;
}

.sp-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.sp-main:active { transform: scale(0.97); }

.sp-icon {
  font-size: 56rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.sp-name { font-size: 26rpx; font-weight: 600; }
.sp-count { font-size: 20rpx; color: #9ca3af; margin-top: 4rpx; }

.sp-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 34rpx;
  height: 34rpx;
  background: #fee2e2;
  color: #dc2626;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.sp-add {
  background: #fafafa;
  border: 4rpx dashed #d1d5db;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 24rpx;
  padding: 24rpx 12rpx;
}

.sp-add .add-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 10rpx;
  border: 4rpx dashed #d1d5db;
}

.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-sheet {
  width: 750rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.modal-handle {
  width: 72rpx;
  height: 8rpx;
  background: #ddd;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.modal-title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.form-group { margin-bottom: 28rpx; }
.form-label { font-size: 26rpx; font-weight: 600; color: #4b5563; margin-bottom: 12rpx; }
.form-input {
  width: 100%;
  border: 2rpx solid #e5e5e5;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  background: #fff;
  box-sizing: border-box;
}
.emoji-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14rpx;
}
.emoji-opt {
  border-radius: 20rpx;
  background: #fafafa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  padding: 18rpx 0;
  border: 4rpx solid transparent;
}
.emoji-opt.selected { background: #fef3c7; border-color: #f59e0b; }
.modal-btns { display: flex; gap: 18rpx; margin-top: 32rpx; }
