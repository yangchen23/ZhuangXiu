.ref-tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #e5e5e5;
  position: sticky;
  top: 0;
  z-index: 10;
}

.ref-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999;
  border-bottom: 4rpx solid transparent;
  font-weight: 500;
}

.ref-tab.active {
  color: #f59e0b;
  border-bottom-color: #f59e0b;
}

/* 收藏入口 */
.bookmark-entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 28rpx 32rpx 20rpx;
  padding: 26rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.be-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  flex-shrink: 0;
}

.be-text { flex: 1; min-width: 0; }
.be-title { font-size: 28rpx; font-weight: 600; }
.be-sub { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.be-arrow { color: #ccc; }

/* 风格速测 */
.style-banner {
  background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
  margin: 0 32rpx 28rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.sb-icon { font-size: 48rpx; }
.sb-text { flex: 1; }
.sb-title { font-size: 28rpx; font-weight: 600; }
.sb-sub { font-size: 24rpx; color: #6b7280; margin-top: 2rpx; }
.sb-arrow { color: #ccc; }

/* 已收藏 */
.saved-bookmarks {
  background: #fff;
  margin: 0 32rpx 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.sb-header {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sb-count { font-size: 22rpx; color: #f59e0b; font-weight: 500; }
.sb-all { font-size: 22rpx; color: #9ca3af; font-weight: 400; }

.sb-item {
  display: flex;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.sb-item:last-of-type { border-bottom: none; }

.sb-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: #f5f5f5;
}

.sb-info { flex: 1; min-width: 0; }
.sb-info .sb-title {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sb-info .sb-sub { font-size: 22rpx; color: #6b7280; margin-top: 2rpx; }
.sb-empty { font-size: 24rpx; color: #9ca3af; text-align: center; padding: 24rpx 0; }

/* 风格图库 */
.style-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx;
  padding: 0 32rpx;
}

.style-card {
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.style-card:active { transform: scale(0.96); }

.sc-img {
  height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.sc-name {
  text-align: center;
  font-size: 22rpx;
  padding: 12rpx 8rpx;
  font-weight: 500;
  background: #fff;
}

/* 工具行 */
.tools-row {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 32rpx;
}

.tool {
  flex: 1;
  background: #fff;
  border-radius: 28rpx;
  padding: 26rpx;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.tool .t-icon { font-size: 48rpx; display: block; }
.tool .t-label { font-size: 24rpx; font-weight: 500; margin-top: 8rpx; display: block; }

/* ===== 知识 ===== */
.search-bar {
  margin: 28rpx 32rpx;
  padding: 20rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.search-icon { font-size: 30rpx; color: #9ca3af; }
.search-bar input { flex: 1; font-size: 28rpx; color: #1a1a1a; }

.ai-tag {
  font-size: 20rpx;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.kg-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx;
  padding: 0 32rpx;
}

.kg-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.kg-icon { font-size: 52rpx; margin-bottom: 8rpx; }
.kg-label { font-size: 22rpx; color: #4b5563; font-weight: 500; }

.faq-list { padding: 0 32rpx 40rpx; }

.faq-item {
  padding: 22rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #1a1a1a;
}

.faq-q { display: flex; align-items: center; gap: 12rpx; }
.faq-num { color: #f59e0b; font-weight: 700; }
.faq-text { flex: 1; }
.faq-hot { color: #ef4444; font-size: 20rpx; font-weight: 600; }
.faq-a {
  margin-top: 14rpx;
  padding: 16rpx;
  background: #fffbeb;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.6;
}

/* ===== 弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-sheet {
  width: 750rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.modal-handle {
  width: 72rpx;
  height: 8rpx;
  background: #ddd;
  border-radius: 4rpx;
  margin: 0 auto 28rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.import-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.import-tab {
  flex: 1;
  padding: 20rpx;
  background: #f3f4f6;
  color: #6b7280;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
}

.import-tab.active {
  background: #dbeafe;
  color: #1e40af;
}

.form-input {
  width: 100%;
  border: 2rpx solid #e5e5e5;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  font-size: 30rpx;
  background: #fff;
  color: #1a1a1a;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 260rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.6;
  background: #fff;
  color: #1a1a1a;
  box-sizing: border-box;
}

.clip-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.clip-btn {
  padding: 12rpx 24rpx;
  background: #fffbeb;
  border: 2rpx solid #fde68a;
  color: #92400e;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.clip-btn.ghost {
  background: #f5f5f5;
  border-color: #e5e5e5;
  color: #6b7280;
}

/* 截图选择 */
.photo-pick {
  border: 4rpx dashed #e5e5e5;
  border-radius: 24rpx;
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  background: #fafafa;
  overflow: hidden;
}

.photo-pick:active { border-color: #f59e0b; }

.photo-pick-img {
  width: 100%;
  height: 320rpx;
}

.pp-icon { font-size: 72rpx; margin-bottom: 12rpx; }
.pp-text { font-size: 26rpx; color: #4b5563; }
.photo-note { font-size: 22rpx; color: #9ca3af; margin-top: 12rpx; }

/* 示例 */
.sample-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 18rpx 0 8rpx;
  font-size: 24rpx;
}

.sample-label { color: #9ca3af; }
.sample-link { color: #3b82f6; font-weight: 500; }

.import-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}

.import-actions .import-btn {
  flex: 2;
  width: auto;
  margin: 0;
}

.import-actions .cancel-btn {
  flex: 1;
  margin: 0;
}

.btn-primary.disabled {
  opacity: 0.6;
}

.import-tip {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: #9ca3af;
  text-align: center;
  line-height: 1.6;
}

/* 分析结果预览 */
.result-ok {
  font-size: 88rpx;
  text-align: center;
  margin-bottom: 4rpx;
}

.result-card {
  background: #f0fdf4;
  border: 2rpx solid #bbf7d0;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 8rpx;
}

.rc2-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.rc2-meta {
  font-size: 22rpx;
  color: #16a34a;
}

.rc2-tip {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #fffbeb;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.6;
}

.modal-btns {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}
