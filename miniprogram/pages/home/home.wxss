/* 顶部元信息 */
.home-meta {
  padding: 24rpx 32rpx 12rpx;
  font-size: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #fef3c7 0%, #fff7ed 100%);
  color: #92400e;
}

/* Hero */
.hero {
  padding: 36rpx 32rpx 44rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: background 0.5s;
}

.hero.sunny { background: linear-gradient(135deg, #fef3c7 0%, #fff7ed 60%, #fef9c3 100%); }
.hero.rainy { background: linear-gradient(180deg, #475569 0%, #64748b 40%, #94a3b8 100%); }
.hero.cloudy { background: linear-gradient(180deg, #e0e7ff 0%, #c7d2fe 50%, #f1f5f9 100%); }

.hero .hg-weather-switch {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #1a1a1a;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  z-index: 3;
  font-weight: 500;
}

.rain-drops {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0.4;
}

.rain-drop {
  position: absolute;
  width: 2rpx;
  height: 28rpx;
  background: linear-gradient(180deg, transparent, #fff);
  animation: rain-fall 1s linear infinite;
}

@keyframes rain-fall {
  0% { transform: translateY(-40rpx); opacity: 0; }
  50% { opacity: 1; }
  100% { transform: translateY(400rpx); opacity: 0; }
}

.hg-emoji {
  font-size: 84rpx;
  margin-bottom: 8rpx;
  display: inline-block;
  position: relative;
  z-index: 2;
}

.hero.sunny .hg-emoji { animation: rotate-sun 8s linear infinite; }
.hero.rainy .hg-emoji { animation: rain-bounce 2s ease-in-out infinite; }

@keyframes rotate-sun {
  0% { transform: rotate(0); }
  100% { transform: rotate(360deg); }
}

@keyframes rain-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.hg-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  position: relative;
  z-index: 2;
}

.hero.rainy .hg-title { color: #fff; }

.hg-stage {
  font-size: 26rpx;
  display: inline-block;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  margin-top: 16rpx;
  position: relative;
  z-index: 2;
  max-width: 82%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
}

.hero.rainy .hg-stage { background: rgba(255, 255, 255, 0.2); color: #e0e7ff; }

.hg-quote {
  margin-top: 20rpx;
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  font-style: italic;
  white-space: pre-line;
  position: relative;
  z-index: 2;
}

.hero.rainy .hg-quote { background: rgba(255, 255, 255, 0.15); color: #f1f5f9; }

/* 天气卡 */
.weather-card {
  margin: -12rpx 32rpx 24rpx;
  padding: 22rpx 26rpx;
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  position: relative;
  z-index: 2;
}

.wc-icon { font-size: 60rpx; }
.wc-text { flex: 1; }
.wc-temp { font-size: 34rpx; font-weight: 700; color: #1e40af; }
.wc-desc { font-size: 22rpx; color: #3b82f6; font-weight: 400; margin-left: 8rpx; }
.wc-air { font-size: 22rpx; color: #3b82f6; margin-top: 4rpx; }
.wc-tip {
  font-size: 20rpx;
  color: #dc2626;
  background: #fff;
  padding: 8rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

/* 昨日未完成 */
.pending-card {
  margin: 0 32rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
  border-left: 8rpx solid #ef4444;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.pending-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #dc2626;
  margin-bottom: 10rpx;
}

.pending-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #4b5563;
}

.pi-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: #fee2e2;
  color: #dc2626;
}

.pi-tag.done { background: #dcfce7; color: #16a34a; }

/* Dashboard 三卡 */
.dash-stats {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.dash-stat {
  flex: 1;
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.dash-stat:active { transform: scale(0.97); }
.dash-stat .s-icon { font-size: 44rpx; display: block; margin-bottom: 4rpx; }
.dash-stat .s-num { font-size: 34rpx; font-weight: 700; color: #1a1a1a; display: block; }
.dash-stat .s-label { font-size: 22rpx; color: #9ca3af; margin-top: 2rpx; display: block; }

/* 开工准备 */
.prep-card { padding: 28rpx; }
.prep-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.prep-title { font-size: 28rpx; font-weight: 600; }
.prep-progress { font-size: 24rpx; color: #f59e0b; font-weight: 600; }
.prep-bar-track {
  height: 16rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.prep-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #d97706);
  border-radius: 8rpx;
  transition: width 0.5s;
}
.prep-items { display: flex; flex-wrap: wrap; gap: 12rpx; }
.prep-tag {
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: #fff;
  color: #6b7280;
  border: 2rpx solid #e5e5e5;
}
.prep-tag.done {
  background: #dcfce7;
  color: #16a34a;
  border-color: #bbf7d0;
}
.prep-tag.done::before { content: '✓ '; }
.prep-tag.next {
  background: #fef3c7;
  color: #d97706;
  border-color: #fde68a;
  font-weight: 600;
}
.prep-tag.next::after { content: ' →'; }
.prep-cta {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.prep-cta-text { font-size: 26rpx; color: #92400e; font-weight: 500; }
.prep-cta-btn {
  padding: 12rpx 26rpx;
  background: #f59e0b;
  color: #fff;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 下一阶段 */
.next-stage-card {
  margin: 0 32rpx 24rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #dbeafe, #eff6ff);
  border-radius: 28rpx;
  border: 2rpx solid #bfdbfe;
}
.ns-title { font-size: 26rpx; font-weight: 600; color: #1e40af; margin-bottom: 8rpx; }
.ns-desc { font-size: 24rpx; color: #3b82f6; line-height: 1.6; margin-bottom: 12rpx; }
.ns-btn {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: #3b82f6;
  color: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 今日贴士 */
.tip-card {
  margin: 0 32rpx 24rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #f3e8ff, #ede9fe);
  border-radius: 28rpx;
  border: 2rpx solid #e9d5ff;
}
.tip-title { font-size: 24rpx; font-weight: 600; color: #7c3aed; margin-bottom: 8rpx; }
.tip-desc { font-size: 24rpx; color: #6b21a8; line-height: 1.6; }
