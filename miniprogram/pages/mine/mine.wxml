<view class="page-wrap">
  <view class="profile">
    <view class="profile-avatar">🏠</view>
    <view class="profile-name">阳光花园 3-201</view>
    <view class="profile-sub">准备期 · 北欧风格</view>
  </view>

  <view class="menu-group">
    <view
      wx:for="{{group1}}"
      wx:key="text"
      class="menu-item"
      data-action="{{item.action}}"
      data-text="{{item.text}}"
      bindtap="onMenu"
    >
      <text class="menu-icon">{{item.icon}}</text>
      <text>{{item.text}}</text>
      <text wx:if="{{item.extra}}" class="menu-extra">{{item.extra}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="menu-group">
    <view
      wx:for="{{group2}}"
      wx:key="text"
      class="menu-item"
      data-action="{{item.action}}"
      data-text="{{item.text}}"
      bindtap="onMenu"
    >
      <text class="menu-icon">{{item.icon}}</text>
      <text>{{item.text}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="version">筑家记 V4.5 · 本地演示版</view>
</view>
