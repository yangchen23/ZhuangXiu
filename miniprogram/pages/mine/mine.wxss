.profile {
  padding: 48rpx 0 40rpx;
  text-align: center;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.profile-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.version {
  text-align: center;
  font-size: 22rpx;
  color: #c0c0c0;
  padding: 24rpx 0 40rpx;
}
