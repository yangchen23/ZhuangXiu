.list-tip {
  padding: 24rpx 32rpx 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.al-item {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  margin: 0 32rpx 16rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.al-item:active { transform: scale(0.98); }

.al-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.al-info { flex: 1; min-width: 0; }
.al-title { font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.al-summary {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.al-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}
.al-read { font-size: 22rpx; color: #f59e0b; font-weight: 500; }
