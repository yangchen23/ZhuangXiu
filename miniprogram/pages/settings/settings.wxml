<view class="page-wrap">
  <view class="st-profile">
    <view class="st-avatar">🏠</view>
    <view class="st-name">{{info.project}}</view>
    <view class="st-sub">{{info.style}} · {{info.stage}} · 预算 {{info.total}}</view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="resetData">
      <text class="menu-icon">🔄</text>
      <text>重置演示数据</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="clearPhotos">
      <text class="menu-icon">🖼️</text>
      <text>清空拍照留档</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="about">
      <text class="menu-icon">ℹ️</text>
      <text>关于筑家记</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="st-note">数据说明：当前为本地模拟模式，数据存在手机本地；接入云开发后可在多设备同步。</view>
</view>
