.co-tip {
  padding: 24rpx 32rpx 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.co-card {
  background: #fff;
  border-radius: 28rpx;
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.co-head { display: flex; align-items: center; gap: 18rpx; }
.co-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.co-info { flex: 1; min-width: 0; }
.co-name { font-size: 30rpx; font-weight: 700; }
.co-type { font-size: 22rpx; color: #9ca3af; margin-top: 2rpx; }
.co-rating { font-size: 26rpx; color: #d97706; font-weight: 600; }

.co-desc { font-size: 26rpx; color: #4b5563; line-height: 1.7; margin-top: 16rpx; }
.co-tags { margin-top: 14rpx; }
.co-bottom {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}
.co-price { font-size: 24rpx; color: #d97706; font-weight: 600; }
.co-orders { font-size: 22rpx; color: #9ca3af; margin-left: 16rpx; flex: 1; }
.co-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
}
