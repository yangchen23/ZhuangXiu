.es2-hero {
  margin: 28rpx 32rpx 24rpx;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 28rpx;
}

.es2-title { font-size: 38rpx; font-weight: 700; color: #92400e; }
.es2-sub { font-size: 24rpx; color: #b45309; margin-top: 8rpx; }

.es2-form { padding: 28rpx; }

.es2-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.es2-label { font-size: 28rpx; color: #4b5563; }
.es2-picker { font-size: 28rpx; color: #f59e0b; font-weight: 600; }
.es2-input {
  width: 160rpx;
  text-align: right;
  font-size: 28rpx;
  color: #f59e0b;
  font-weight: 600;
}

.es2-result { padding: 28rpx; }

.er-range {
  font-size: 48rpx;
  font-weight: 700;
  color: #d97706;
}

.er-sub { font-size: 26rpx; color: #6b7280; margin-top: 8rpx; }
.er-note { font-size: 20rpx; color: #9ca3af; margin-top: 8rpx; line-height: 1.5; }

.er-items { margin-top: 20rpx; }
.er-item { margin-bottom: 18rpx; }
.er-item-head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 8rpx;
}
.er-item-amount { color: #1a1a1a; font-weight: 600; }
.er-bar-track { height: 12rpx; background: #f3f4f6; border-radius: 6rpx; overflow: hidden; }
.er-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #d97706);
  border-radius: 6rpx;
}

.er-save { margin-top: 28rpx; }
