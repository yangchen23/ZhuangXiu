.budget-hero {
  background: linear-gradient(135deg, #fef3c7 0%, #fffbeb 100%);
  padding: 32rpx 28rpx 36rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.bh-label { font-size: 24rpx; color: #92400e; margin-bottom: 8rpx; }
.bh-sub { font-size: 26rpx; color: #1a1a1a; margin-bottom: 20rpx; }

.bh-cards {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.bh-card {
  flex: 1;
  text-align: center;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  padding: 16rpx 8rpx;
}

.bh-num { font-size: 34rpx; font-weight: 700; color: #1a1a1a; }
.bh-name { font-size: 22rpx; color: #92400e; margin-top: 2rpx; }

.bh-bar-track {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 6rpx;
  overflow: hidden;
}

.bh-bar-fill {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, #f59e0b, #d97706);
  border-radius: 6rpx;
  transition: width 0.5s;
}

.bh-bar-fill.warn { background: linear-gradient(90deg, #ef4444, #dc2626); }

/* 类目 */
.cat-list { padding: 0 32rpx; }

.budget-cat-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.bc-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.bc-icon { font-size: 44rpx; flex-shrink: 0; }
.bc-info { flex: 1; min-width: 0; }
.bc-name { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.bc-sub { font-size: 22rpx; color: #9ca3af; margin-top: 2rpx; }
.bc-amount { font-size: 26rpx; font-weight: 700; text-align: right; flex-shrink: 0; }
.bc-limit { color: #9ca3af; font-size: 22rpx; font-weight: 400; }

.bc-bar-track {
  height: 10rpx;
  background: #f3f4f6;
  border-radius: 5rpx;
  overflow: hidden;
}

.bc-bar-fill {
  height: 100%;
  width: 0;
  border-radius: 5rpx;
  transition: width 0.5s;
}

.bc-bar-fill.warn { background: linear-gradient(90deg, #ef4444, #dc2626) !important; }

.bc-warn {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #dc2626;
  font-weight: 500;
}

/* 流水 */
.budget-flow-item {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  margin: 0 32rpx 16rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.03);
}

.bfi-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.bfi-info { flex: 1; min-width: 0; }
.bfi-title { font-size: 26rpx; font-weight: 600; }
.bfi-meta { font-size: 22rpx; color: #9ca3af; margin-top: 2rpx; }
.bfi-type {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: #fef3c7;
  color: #d97706;
  margin-top: 4rpx;
  display: inline-block;
}

.bfi-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: right;
  flex-shrink: 0;
}

.budget-footer {
  margin: 40rpx 32rpx 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  border-radius: 28rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3);
}

.empty-box .eb-desc { white-space: pre-line; }
